---
---

<header class="site-header">
  <div class="logo">ポートフォリオ</div>
  <nav class="pc-menu">
    <a href="#home">ホーム</a>
    <a href="#about">私について</a>
    <a href="#skills">スキル</a>
  </nav>

  <button class="mobile-menu-btn" id="menu-toggle" aria-label="メニューを開く">
    <span class="line"></span>
    <span class="line"></span>
    <span class="line"></span>
  </button>

  <nav class="mobile-menu" id="mobile-menu">
    <a href="#home" class="mobile-link">ホーム</a>
    <a href="#about" class="mobile-link">私について</a>
    <a href="#skills" class="mobile-link">スキル</a>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    background-color: transparent;
    transition: background-color 0.3s ease;
    color: #fff;
    z-index: 100;
    box-sizing: border-box;
  }
  .site-header.scrolled {
    background-color: #000000;
  }

  .pc-menu {
    display: flex;
    gap: 16px;
  }

  .pc-menu a {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.8rem;
    text-decoration: none;
    transition: color 0.2s;
  }

  .pc-menu a:hover {
    color: #ffffff;
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .mobile-menu .line {
    width: 100%;
    height: 2px;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 2px;
    transition: transform 0.3s, opacity 0.3s;
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 800px) {
    .pc-menu     { display: none; }
    .mobile-menu { display: flex; }
    .mobile-nav {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      position: fixed;
      gap: 16px;
      top: 56px;
      right: 0;
      width: 200px;
      background-color: #000000;
      padding: 16px;
      box-shadow: -2px 0 5px rgba(0, 0, 0, 0.5);
    }

    .mobile-nav a {
      color: #ffffff;
      text-decoration: none;
      font-size: 0.8rem;
    }

    .mobile-nav.is-active {
      display: flex;
      visibility: visible;
    }

    .mobile-menu-btn.is-active .line:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }
    .mobile-menu-btn.is-active .line:nth-child(2) {
      opacity: 0;
    }
    .mobile-menu-btn.is-active .line:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }
  }
</style>